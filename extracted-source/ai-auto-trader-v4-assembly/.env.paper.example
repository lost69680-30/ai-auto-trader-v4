# Example values for the local paper simulation only. Adjust fee/slippage and
# risk inputs to researched assumptions before interpreting any performance.
# No Binance API keys are required or used by this application.
PAPER_MARKET_TESTNET=true
PAPER_SYMBOLS=BTCUSDT,ETHUSDT
PAPER_DATABASE_PATH=./data/paper-ledger.sqlite3
PAPER_SIMULATED_EQUITY=1000
PAPER_RISK_FRACTION=0.005
PAPER_MAX_POSITION_NOTIONAL=100
PAPER_MAX_GROSS_EXPOSURE=1000
PAPER_MAX_DAILY_LOSS=20
PAPER_MAX_OPEN_POSITIONS=2
PAPER_MAX_RISK_PER_TRADE=5
PAPER_MAX_SIGNAL_AGE_SECONDS=60
PAPER_ESTIMATED_ROUND_TRIP_COST_PCT=0.12
PAPER_FEE_RATE=0.0004
PAPER_SLIPPAGE_BPS=2
PAPER_POLL_INTERVAL_SECONDS=5
PAPER_CANDLE_INTERVAL=1m
PAPER_CANDLE_LIMIT=100
PAPER_MAX_MARKET_AGE_SECONDS=90
PAPER_PLAN_LIFETIME_SECONDS=20
PAPER_WATCHER_MAX_AGE_SECONDS=10
PAPER_TRAILING_DISTANCE_PCT=0.02
PAPER_TRAILING_ACTIVATION_PCT=0.01
